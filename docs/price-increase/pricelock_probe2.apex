Account a = [SELECT Id, OwnerId, Client_Success_Rep_2__c FROM Account WHERE Id = '0010f00002KTyDcAAL'];
Contact c = [SELECT Id FROM Contact WHERE AccountId = :a.Id LIMIT 1];
Id stdRt = [SELECT Id FROM RecordType WHERE SobjectType='Opportunity' AND DeveloperName='Standard_Opportunity' LIMIT 1].Id;
// a real subscription product from the standard price book, as the escalation record would reference
PricebookEntry pbe = [SELECT Id, Product2.Name, Product2.Family, UnitPrice FROM PricebookEntry WHERE Pricebook2.IsStandard = true AND IsActive = true AND Product2.IsActive = true AND Product2.Name LIKE '%Citation%' LIMIT 1];
System.debug('PRODUCT ' + pbe.Product2.Name + ' | family ' + pbe.Product2.Family + ' | list ' + pbe.UnitPrice);
Savepoint sp = Database.setSavepoint();
Opportunity o = new Opportunity(Name = 'ZZ TEST PROBE - 5% Increase Rev Enhancement - 2027 (rollback)', AccountId = a.Id, RecordTypeId = stdRt, Type = 'Revenue Enhancement', StageName = 'Discovery', CloseDate = Date.today().addMonths(3), LeadSource = 'Client Success', ForecastCategoryName = 'Pipeline', NextStep = 'Send 60-day notice', Client_Success_Rep__c = a.Client_Success_Rep_2__c);
insert o;
OpportunityLineItem li = new OpportunityLineItem(OpportunityId = o.Id, PricebookEntryId = pbe.Id, Quantity = 1, UnitPrice = 2953.20, Description = '5% escalation on annual subscription');
Database.SaveResult rl = Database.insert(li, false);
System.debug('B1 line item success=' + rl.isSuccess());
for (Database.Error e : rl.getErrors()) System.debug('B1 ERR ' + e.getFields() + ' ' + e.getMessage());
o = [SELECT Id, Amount, Product_Family_RU__c FROM Opportunity WHERE Id = :o.Id];
System.debug('B2 amount after line=' + o.Amount + ' | family rollup=' + o.Product_Family_RU__c);
o.StageName = 'Contract'; o.NextStep = 'Notice sent';
Database.SaveResult r2 = Database.update(o, false);
System.debug('B3 to Contract success=' + r2.isSuccess());
for (Database.Error e : r2.getErrors()) System.debug('B3 ERR ' + e.getFields() + ' ' + e.getMessage());
o.StageName = 'Closed Won'; o.NextStep = 'Done'; o.Why_Passport__c = 'Contractual escalator';
Database.SaveResult r3 = Database.update(o, false);
System.debug('B4 to Closed Won success=' + r3.isSuccess());
for (Database.Error e : r3.getErrors()) System.debug('B4 ERR ' + e.getFields() + ' ' + e.getMessage());
Task t = new Task(Subject = 'Price increase notice due', WhatId = a.Id, WhoId = c.Id, OwnerId = a.Client_Success_Rep_2__c, ActivityDate = Date.today().addDays(14), Status = 'Not Started', Priority = 'Normal');
Database.SaveResult r4 = Database.insert(t, false);
System.debug('B5 task with contact success=' + r4.isSuccess());
for (Database.Error e : r4.getErrors()) System.debug('B5 ERR ' + e.getMessage());
System.debug('LIMITS soql=' + Limits.getQueries() + '/' + Limits.getLimitQueries() + ' dml=' + Limits.getDmlStatements() + ' cpu=' + Limits.getCpuTime() + ' emails=' + Limits.getEmailInvocations());
Database.rollback(sp);
System.debug('ROLLED BACK');
