    <formulas>
        <name>varClientSuccessRep</name>
        <dataType>String</dataType>
        <expression>IF(
    ISNULL({!$Record.Client_Success_Rep__c}),
    {!$Record.OwnerId},
    {!$Record.Client_Success_Rep__c}
)</expression>
    </formulas>
    <formulas>
        <name>varCloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(
    ADDMONTHS({!varNextRenewal}, -3) &lt; TODAY(),
    TODAY(),
    ADDMONTHS({!varNextRenewal}, -3)
)</expression>
    </formulas>
    <formulas>
        <name>fFallbackRenewal</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(), 12)</expression>
    </formulas>
    <formulas>
        <name>varName</name>
        <dataType>String</dataType>
        <expression>{!varBaseName} &amp; &quot; - &quot; &amp; {!varYear} &amp; &quot; Renewal&quot;</expression>
    </formulas>
    <formulas>
        <name>varRenewalType</name>
        <dataType>String</dataType>
        <expression>IF(
  ISBLANK( TEXT({!$Record.Renewal_Typ__c}) ),
  &quot;&quot;,
  TEXT({!$Record.Renewal_Typ__c})
)</expression>
    </formulas>
    <formulas>
        <name>varYear</name>
        <dataType>String</dataType>
        <expression>TEXT( YEAR( {!varNextRenewal} ) )</expression>
    </formulas>
