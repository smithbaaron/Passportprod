        <name>Screen_Saved</name>
        <label>Client Saved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Saved</targetReference>
        </connector>
        <fields>
            <name>Saved_Action</name>
            <dataType>String</dataType>
            <fieldText>What action saved this client?</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Saved_Resolution</name>
            <dataType>String</dataType>
            <fieldText>How was the risk resolved?</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Churned</name>
        <label>Client Churned</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Churned</targetReference>
        </connector>
        <fields>
