        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Former_Msg</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!Get_Account.Name} is a former client.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;At-risk check-ins only apply to current clients. If this account has an old open at-risk case, it will be closed out in the churned-client cleanup.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_No_Case</name>
        <label>No Open Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Case_Msg</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!Get_Account.Name} has no open at-risk case.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Nothing to update. If this client is newly at risk, use the &lt;b&gt;Mark Client as At Risk&lt;/b&gt; action to open a case first.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Triage</name>
        <label>At-Risk Check-In</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Outcome_Branch</targetReference>
        </connector>
        <fields>
            <name>Context_Summary</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!Get_Account.Name}&lt;/b&gt; — case {!Get_Open_Case.Name}&lt;/p&gt;&lt;p&gt;Current risk level: &lt;b&gt;{!Get_Open_Case.Churn_Risk_Spectrum__c}&lt;/b&gt;&lt;br/&gt;Predicted churn date: {!Get_Open_Case.Predicted_Churn_Date__c}&lt;br/&gt;At risk since: {!Get_Open_Case.At_Risk_Date__c}&lt;br/&gt;Primary cause: {!Get_Open_Case.Primary_At_Risk_Cause__c}&lt;br/&gt;Last check-in: {!Get_Open_Case.Last_Check_In__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Outcome_Radio</name>
            <choiceReferences>cStill</choiceReferences>
            <choiceReferences>cSaved</choiceReferences>
            <choiceReferences>cChurned</choiceReferences>
            <dataType>String</dataType>
            <fieldText>What is the outcome of this check-in?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Still</name>
        <label>Check-In Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Still_At_Risk</targetReference>
        </connector>
        <fields>
            <name>Spectrum_Radio</name>
            <choiceReferences>dsSpectrum</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Current churn risk level (was: {!Get_Open_Case.Churn_Risk_Spectrum__c})</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>PC_Date</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>Get_Open_Case.Predicted_Churn_Date__c</elementReference>
            </defaultValue>
            <fieldText>Predicted churn date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Spectrum_Radio</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Predicted Churn</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Repair_Radio</name>
            <choiceReferences>dsRepair</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Current action being taken (was: {!Get_Open_Case.Repair_Plan_Status__c})</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Next_Steps_Input</name>
            <dataType>String</dataType>
            <fieldText>Next steps from this check-in</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
