    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get the Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Open_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Status__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Case</name>
        <label>Get the Open At-Risk Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Account_State</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>At_Risk_Journey_is_Open__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>At_Risk_Journey__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Churn_Risk_Spectrum__c</queriedFields>
        <queriedFields>Predicted_Churn_Date__c</queriedFields>
        <queriedFields>Primary_At_Risk_Cause__c</queriedFields>
        <queriedFields>Repair_Plan_Status__c</queriedFields>
        <queriedFields>At_Risk_Date__c</queriedFields>
        <queriedFields>At_Risk_Next_Steps__c</queriedFields>
        <queriedFields>At_Risk_Client_Explanation__c</queriedFields>
        <queriedFields>Last_Check_In__c</queriedFields>
        <queriedFields>At_Risk_Journey_is_Open__c</queriedFields>
        <queriedFields>Derisked_Client_Action__c</queriedFields>
        <queriedFields>Derisked_Resolution__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Case</name>
        <label>Save the Check-In</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_Done</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Fault</targetReference>
        </faultConnector>
        <inputReference>Get_Open_Case</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Case_Churned</name>
        <label>Close Case as Churned</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Account_Churn</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Fault</targetReference>
        </faultConnector>
        <inputReference>Get_Open_Case</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Account_Churn</name>
        <label>Record Churn on the Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_Done</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Churn_Reason__c</field>
            <value>
                <elementReference>Churn_Reason_Radio</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Churn_Explanation__c</field>
            <value>
                <elementReference>Churn_Details</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
