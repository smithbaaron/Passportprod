    <choices>
        <name>cStill</name>
        <choiceText>Still at risk - recording a check-in</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Still</stringValue>
        </value>
    </choices>
    <choices>
        <name>cSaved</name>
        <choiceText>Client saved - close this case as de-risked</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Saved</stringValue>
        </value>
    </choices>
    <choices>
        <name>cChurned</name>
        <choiceText>Client churned - close this case and record the churn</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Churned</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Check_Account_State</name>
        <label>Former Client or No Case?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Triage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Open Case</defaultConnectorLabel>
        <rules>
            <name>Is_Former</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Former</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Former</targetReference>
            </connector>
            <label>Former Client</label>
        </rules>
        <rules>
            <name>No_Open_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_No_Case</targetReference>
            </connector>
            <label>No Open Case</label>
        </rules>
    </decisions>
    <decisions>
        <name>Outcome_Branch</name>
        <label>Check-In Outcome?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Still</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Still at Risk</defaultConnectorLabel>
        <rules>
            <name>Outcome_Saved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Outcome_Radio</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Saved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Saved</targetReference>
            </connector>
            <label>Saved</label>
        </rules>
        <rules>
            <name>Outcome_Churned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Outcome_Radio</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Churned</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Churned</targetReference>
            </connector>
            <label>Churned</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
