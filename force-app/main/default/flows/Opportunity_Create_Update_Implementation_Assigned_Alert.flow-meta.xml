    <apiVersion>64.0</apiVersion>
    <decisions>
        <name>PM_Triggered</name>
        <label>Project Manager Assigned or Changed?</label>
        <locationX>100</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>IC_Triggered</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>PM_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Project_Manager__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Project_Manager__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Project_Manager__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_PM_Email</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
