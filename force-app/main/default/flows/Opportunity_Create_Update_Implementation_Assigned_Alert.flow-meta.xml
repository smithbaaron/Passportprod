    <description>Emails implementation assignments on Opportunity. Fires when Project Manager or Implementation Consultant is set/changed to a non-blank value (including at creation). PM alert goes to the PM user's email; consultant alert routes by the Implementation Consultant picklist value to that consultant's address. aaron.smith@passportinc.com is CC'd on both. Rebuilt from v6, which routed on the wrong field (PM name) and had lost its recipient addresses.</description>
    <environments>Default</environments>
    <formulas>
        <name>fPMRecipients</name>
        <dataType>String</dataType>
        <expression>{!$Record.Project_Manager__r.Email} &amp; ",aaron.smith@passportinc.com"</expression>
    </formulas>
    <interviewLabel>Implementation Assigned Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Create/Update - Implementation Assigned Alert</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>100</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>PM_Triggered</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>SubjectPM</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>NEW IMPLEMENTATION ASSIGNMENT ALERT| {!$Record.Account.Name} | {!$Record.Project_Manager__r.FirstName} {!$Record.Project_Manager__r.LastName}</text>
    </textTemplates>
    <textTemplates>
        <name>BodyPM</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>NEW IMPLEMENTATION ASSIGNMENT ALERT

You have been assigned as the new Implementation PM for:

Account: {!$Record.Account.Name}
Opportunity Name: {!$Record.Name}
Opportunity Link: https://passportlabs.lightning.force.com/{!$Record.Id}

New Implementation Project Manager: {!$Record.Project_Manager__r.FirstName} {!$Record.Project_Manager__r.LastName}</text>
    </textTemplates>
    <textTemplates>
        <name>SubjectIC</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
