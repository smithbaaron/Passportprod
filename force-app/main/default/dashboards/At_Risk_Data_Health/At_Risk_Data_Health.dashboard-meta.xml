<?xml version="1.0" encoding="UTF-8"?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
    <backgroundEndColor>#FFFFFF</backgroundEndColor>
    <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
    <backgroundStartColor>#FFFFFF</backgroundStartColor>
    <dashboardType>SpecifiedUser</dashboardType>
    <description>Live view of the at-risk data issues discussed with CS and Cecily: zombie cases, duplicates, overdue churn dates, blocked former accounts, the living at-risk book, and stale updates.</description>
    <isGridLayout>false</isGridLayout>
    <leftSection>
        <columnSize>Medium</columnSize>
        <components>
            <componentType>Metric</componentType>
            <header>Zombie cases on churned clients</header>
            <indicatorBreakpoint1>1.0</indicatorBreakpoint1>
            <indicatorBreakpoint2>50.0</indicatorBreakpoint2>
            <indicatorHighColor>#C25454</indicatorHighColor>
            <indicatorLowColor>#54C254</indicatorLowColor>
            <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
            <report>At_Risk_Data_Health/Zombie_Cases_Churned_Clients</report>
            <title>Awaiting CS resolution wording</title>
        </components>
        <components>
            <componentType>Metric</componentType>
            <header>Accounts with 2+ open cases</header>
            <indicatorBreakpoint1>1.0</indicatorBreakpoint1>
            <indicatorBreakpoint2>50.0</indicatorBreakpoint2>
            <indicatorHighColor>#C25454</indicatorHighColor>
            <indicatorLowColor>#54C254</indicatorLowColor>
            <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
            <report>At_Risk_Data_Health/Duplicate_Open_At_Risk_Cases</report>
            <title>CS picks the surviving case</title>
        </components>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Column</componentType>
            <displayUnits>Auto</displayUnits>
            <header>Zombie cases by vintage</header>
            <report>At_Risk_Data_Health/Zombie_Cases_Churned_Clients</report>
            <sortBy>RowLabelAscending</sortBy>
        </components>
    </leftSection>
    <middleSection>
        <columnSize>Medium</columnSize>
        <components>
            <componentType>Metric</componentType>
            <header>Overdue predicted churn (living clients)</header>
            <indicatorBreakpoint1>1.0</indicatorBreakpoint1>
            <indicatorBreakpoint2>50.0</indicatorBreakpoint2>
            <indicatorHighColor>#C25454</indicatorHighColor>
            <indicatorLowColor>#54C254</indicatorLowColor>
            <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
            <report>At_Risk_Data_Health/Overdue_Predicted_Churn_Living</report>
            <title>Churn in wrong reporting period</title>
        </components>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Donut</componentType>
            <displayUnits>Auto</displayUnits>
            <header>Living at-risk book by risk level</header>
            <legendPosition>Bottom</legendPosition>
            <report>At_Risk_Data_Health/Living_At_Risk_Book</report>
            <sortBy>RowValueDescending</sortBy>
        </components>
    </middleSection>
    <rightSection>
        <columnSize>Medium</columnSize>
        <components>
            <componentType>Metric</componentType>
            <header>Former accounts still flagged</header>
            <indicatorBreakpoint1>1.0</indicatorBreakpoint1>
            <indicatorBreakpoint2>50.0</indicatorBreakpoint2>
            <indicatorHighColor>#C25454</indicatorHighColor>
            <indicatorLowColor>#54C254</indicatorLowColor>
            <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
            <report>At_Risk_Data_Health/Former_Still_Flagged_Blocked</report>
            <title>Blocked until churn explanation entered</title>
        </components>
        <components>
            <componentType>Metric</componentType>
            <header>Stale open cases (60+ days)</header>
            <indicatorBreakpoint1>1.0</indicatorBreakpoint1>
            <indicatorBreakpoint2>50.0</indicatorBreakpoint2>
            <indicatorHighColor>#C25454</indicatorHighColor>
            <indicatorLowColor>#54C254</indicatorLowColor>
            <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
            <report>At_Risk_Data_Health/Stale_Open_Cases_60_Days</report>
            <title>The update-cadence gap</title>
        </components>
        <components>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Column</componentType>
            <displayUnits>Auto</displayUnits>
            <header>Revenue still on Former/Prospect accounts</header>
            <report>At_Risk_Data_Health/Former_Prospect_Still_Generating_Revenue</report>
            <sortBy>RowValueDescending</sortBy>
        </components>
    </rightSection>
    <runningUser>aaron.smith@passportinc.com</runningUser>
    <textColor>#000000</textColor>
    <title>At-Risk Data Health</title>
    <titleColor>#000000</titleColor>
    <titleSize>12</titleSize>
</Dashboard>
