    <description>Former accounts with NetSuite revenue above zero, grouped by churn year. Churned over 12 months ago or undated = not explained by a trailing-12-month window: still billing, or a stale NetSuite customer. Questions: Aaron Smith.</description>
    <filter>
        <criteriaItems>
            <column>Account.Status__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Former</value>
        </criteriaItems>
        <criteriaItems>
            <column>Account.NS_Revenue__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>0</value>
        </criteriaItems>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Year</dateGranularity>
        <field>Account.Churn_Date__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Former Accounts With NetSuite Revenue</name>
    <reportType>AccountList</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <timeFrameFilter>
        <dateColumn>CREATED_DATE</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
