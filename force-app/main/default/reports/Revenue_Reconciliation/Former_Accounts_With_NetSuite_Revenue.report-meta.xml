        <aggregateTypes>Sum</aggregateTypes>
        <field>Account.NS_Revenue__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Account.Recurring_NS__c</field>
    </columns>
    <columns>
